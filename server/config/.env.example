# Copy this file to .env and fill in your own values.
# Never upload the real .env file to GitHub.

# Database
DB_NAME=sustain_home_store
# Only for the online demo: MongoDB Atlas connection string (leave empty on your computer)
MONGODB_URI=

# Server Port
SERVER_PORT=4000

# Access Levels
ACCESS_LEVEL_GUEST=0
ACCESS_LEVEL_NORMAL_USER=1
ACCESS_LEVEL_ADMIN=2

# JWT
JWT_EXPIRY=7d

# Password Encryption
PASSWORD_HASH_SALT_ROUNDS=10

# Uploaded Files
UPLOADED_FILES_FOLDER=./uploads

# Client address (for CORS and PayPal return links)
LOCAL_HOST=http://localhost:3000
# Only for the online demo: the address of the React site, for example https://sustain-home-store.onrender.com
# CLIENT_URL=

# PayPal Sandbox (from developer.paypal.com -> Apps & Credentials)
PAYPAL_CLIENT_ID=your_sandbox_client_id
PAYPAL_SECRET=your_sandbox_secret

# Admin account created by "npm run seed -- --admin"
ADMIN_EMAIL=admin@admin.com
ADMIN_PASSWORD=

# Only for the online demo: the JWT keys as text (on your computer the files in server/keys are used)
# JWT_PRIVATE_KEY=
# JWT_PUBLIC_KEY=

# Environment (development enables /api/users/reset_user_collection)
NODE_ENV=development
